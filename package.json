{
  "name": "tapcollect",
  "version": "0.3.7",
  "description": "可配置的网页列表与详情信息采集、XML/Excel 模板映射和分批导出工具",
  "main": "./out/main/index.js",
  "author": {
    "name": "Sylvan",
    "email": "CastleInTheSky0@users.noreply.github.com"
  },
  "homepage": "https://github.com/CastleInTheSky0/TapCollect",
  "repository": {
    "type": "git",
    "url": "https://github.com/CastleInTheSky0/TapCollect.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/patch-sheetjs-biff8.mjs && node ./scripts/ensure-electron.mjs",
    "dev": "node ./scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:preload": "npm run build && node ./scripts/run-preload-smoke.mjs",
    "smoke:sample": "npm run build && electron ./out/main/sample-smoke.js",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:uos-arm64": "npm run build && electron-builder --linux deb --arm64 --publish never",
    "build:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "build:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "build": {
    "appId": "cn.local.tapcollect",
    "productName": "TapCollect",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/main/preload-smoke.js",
      "!out/main/sample-smoke.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TapCollect-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TapCollect",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "tapcollect-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "notarize": false,
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "TapCollect-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "chardet": "2.2.0",
    "fontoxpath": "3.34.0",
    "iconv-lite": "0.7.3",
    "jsdom": "27.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-formatter": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.10.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "tdesign-icons-vue-next": "^0.4.7",
    "tdesign-vue-next": "^1.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  }
}
